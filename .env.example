# База данных PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/boosty"

# Секрет для сессий (любая длинная случайная строка)
AUTH_SECRET="замените-на-длинную-случайную-строку"

# Адрес сайта (нужен для коротких ссылок и уведомлений)
APP_URL="http://localhost:3000"

# Комиссия сервиса в процентах
NEXT_PUBLIC_COMMISSION_PERCENT=15

# Аккаунт владельца, создаётся командой npm run db:seed
OWNER_PHONE="+998901234567"
OWNER_PASSWORD="поменяйте-пароль"

# Telegram-бот (создать у @BotFather) — уведомления админам каналов
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="boosty_bot"

# Сбор просмотров постов (служебный аккаунт Telegram, ключи на my.telegram.org)
TG_API_ID=""
TG_API_HASH=""
TG_SESSION=""
