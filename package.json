{
  "name": "boosty",
  "version": "0.1.0",
  "private": true,
  "description": "Boosty — реклама в Telegram-каналах Узбекистана без крипты",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "bot": "tsx --env-file=.env bot/index.ts",
    "stats": "tsx --env-file=.env worker/stats.ts",
    "stats:login": "tsx --env-file=.env worker/login.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "grammy": "1.30.0",
    "jose": "5.9.6",
    "next": "14.2.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "telegram": "2.26.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
